{
  "extends": ["config:base", "group:all", "schedule:weekly"],
  "assigneesFromCodeOwners": true,
  "assigneesSampleSize": 1,
  "separateMinorPatch": true,
  "packageRules": [
    {
      "updateTypes": ["patch"],
      "enabled": false
    },
    {
      "description": "Behat tests run against older Redmine versions on purpose, new releases are reported by check-for-releases.yml",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["redmine"],
      "enabled": false
    }
  ]
}
