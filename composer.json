{
    "name": "kbsali/redmine-api",
    "version": "v2.10.0-dev",
    "type": "library",
    "description": "Redmine API client",
    "homepage": "https://github.com/kbsali/php-redmine-api",
    "keywords": [
        "redmine",
        "api"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Kevin Saliou",
            "email": "kevin@saliou.name",
            "homepage": "http://kevin.saliou.name"
        },
        {
            "name": "Artur Weigandt",
            "email": "artur@wlabs.de",
            "homepage": "https://wlabs.de"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0",
        "ext-curl": "*",
        "ext-simplexml": "*",
        "ext-json": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0"
    },
    "require-dev": {
        "art4/rector-bc-library": "^1.1",
        "behat/behat": "^3.15",
        "friendsofphp/php-cs-fixer": "^3.95",
        "guzzlehttp/psr7": "^2.8 || ^3.0",
        "pestphp/pest": "^5.0",
        "php-mock/php-mock-phpunit": "^2.15",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.5 || ^12.5 || ^13.0",
        "rector/rector": "^2.5"
    },
    "autoload": {
        "psr-4": {
            "Redmine\\": "src/Redmine/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Redmine\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "bdt": [
            "Composer\\Config::disableProcessTimeout",
            "@behat --format=progress --suite=redmine_7_0",
            "@behat --format=progress --suite=redmine_6_1",
            "@behat --format=progress --suite=redmine_6_0",
            "@behat --format=progress --suite=redmine_5_1"
        ],
        "behat": "behat --config tests/Behat/behat.yml",
        "codestyle": "php-cs-fixer fix",
        "coverage": "phpunit -c tests/phpunit-coverage.dist.xml --coverage-html=\".phpunit.cache/code-coverage\"",
        "phpstan": "phpstan analyze --memory-limit 512M --configuration .phpstan.neon",
        "pest": "pest --config phpunit.pest.dist.xml",
        "phpunit": "phpunit -c phpunit.dist.xml",
        "rectify": [
            "@rector",
            "@codestyle"
        ],
        "rector": "rector -c .rector.php",
        "test": [
            "@phpstan",
            "@phpunit",
            "@rector --dry-run",
            "@codestyle --dry-run --diff"
        ]
    }
}
